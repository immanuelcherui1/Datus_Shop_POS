# Copy to .env. Generate each secret with: python -c "import secrets; print(secrets.token_hex(32))"
DATABASE_URL=postgresql+psycopg://datus:CHANGE_ME@127.0.0.1:5432/datus
SECRET_KEY=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_SECRET_KEY=GENERATE_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
COOKIE_SECURE=false
BUSINESS_NAME=DATUS Retail & Wholesale
CURRENCY=KES
BUSINESS_TIMEZONE=Africa/Nairobi
# Single-PC deployment binds only to loopback. Use TLS before exposing over a network.
HOST=127.0.0.1
PORT=8080
# Optional encrypted S3-compatible cloud backup. Credentials use the AWS SDK credential chain.
BACKUP_BUCKET=
BACKUP_PREFIX=datus
BACKUP_ENDPOINT_URL=
BACKUP_KEY_FILE=
PG_DUMP=pg_dump
PG_RESTORE=pg_restore
